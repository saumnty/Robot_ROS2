<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="default">
    <gravity>0 0 -9.8</gravity>

    <!-- Suelo base con colisión plana -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>5.0</mu>
                <mu2>5.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0 0.8 0 1</ambient>
            <diffuse>0 0.8 0 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- Cuadrante NE - Normal (gris) mu=1.0 -->
    <model name="suelo_NE">
      <static>true</static>
      <pose>5 5 0.001 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <box><size>10 10 0.01</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry>
            <box><size>10 10 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cuadrante NW - Resbaloso (azul) mu=0.2 -->
    <model name="suelo_NW">
      <static>true</static>
      <pose>-5 5 0.001 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <box><size>10 10 0.01</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.05</mu><mu2>0.05</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry>
            <box><size>10 10 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.7 1.0 1</ambient>
            <diffuse>0.5 0.7 1.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cuadrante SW - Moderado (verde) mu=0.6 -->
    <model name="suelo_SW">
      <static>true</static>
      <pose>-5 -5 0.001 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <box><size>10 10 0.01</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.6</mu><mu2>0.6</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry>
            <box><size>10 10 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.8 0.4 1</ambient>
            <diffuse>0.6 0.8 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cuadrante SE - Rugoso (café) mu=2.5 -->
    <model name="suelo_SE">
      <static>true</static>
      <pose>5 -5 0.001 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <box><size>10 10 0.01</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>2.5</mu><mu2>2.5</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry>
            <box><size>10 10 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bolitabot -->
    <include>
      <uri>model://bolitabot_casters.sdf</uri>
      <pose>0 0 0.0 0 0 0</pose>
    </include>

  </world>
</sdf>